static_resources:
  listeners:
    - name: ventas_to_inventario
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 10000
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ventas_proxy
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: inventario
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: inventario_cluster
                            # [1] timeout = 4.5s
                            # Mínimo: connect_timeout × (1 + num_retries) + backoff máximo
                            #       = 2s × (1 + 1) + 0.125s (0.1s + 25 % de jitter) = 4.125s → 4.5s deja 0.375s de margen.
                            # No se sube más: cada petición que llega antes de que abra el circuito espera este tiempo
                            # completo y eso empuja el p99 del ASR-1 (< 3 s).
                            # Es menor que INVENTARIO_TIMEOUT_MS (9000 ms), así Ventas no aborta antes que el sidecar.
                            timeout: 4.5s
                            retry_policy:
                              retry_on: "5xx,reset,connect-failure,gateway-error"
                              # [2] num_retries = 1
                              # A lo sumo 1 llamada original + 1 reintento = 2 llamadas a Inventario por venta.
                              # Factor de amplificación ≤ 2, el máximo que permite el ASR-2.
                              num_retries: 1
                              retry_back_off:
                                # [3] base_interval = 0.1s
                                # Con el jitter de ±25 % de Envoy la espera queda entre 75 y 125 ms: dispersa los
                                # reintentos de muchas ventas simultáneas (evita reintentos sincronizados) sin sumar
                                # latencia perceptible.
                                base_interval: 0.1s
                                # [4] max_interval = 1s
                                # Tope del backoff exponencial. Con num_retries = 1 solo hay una espera (≤ 0.125s) y el
                                # tope no se alcanza, pero garantiza que si se suben los reintentos el backoff siga
                                # cabiendo dentro del timeout de la ruta.
                                max_interval: 1s
                              retry_host_predicate:
                                - name: envoy.retry_host_predicates.previous_hosts
                                  typed_config:
                                    "@type": type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate
                              host_selection_retry_max_attempts: "3"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: inventario_cluster
      connect_timeout: 2s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      # Sin panic mode: cuando todos los hosts están eyectados (circuito OPEN), Envoy responde
      # 503 inmediato (flag UH) en lugar de seguir enviando tráfico al host caído.
      common_lb_config:
        healthy_panic_threshold:
          value: 0
      load_assignment:
        cluster_name: inventario_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      # Sustituido en tiempo de arranque por entrypoint.sh mediante envsubst.
                      # docker-compose → INVENTARIO_UPSTREAM_HOST=inventario, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (mismo task) → INVENTARIO_UPSTREAM_HOST=localhost, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (cross-task) → INVENTARIO_UPSTREAM_HOST=<ALB DNS>, INVENTARIO_UPSTREAM_PORT=80
                      address: ${INVENTARIO_UPSTREAM_HOST}
                      port_value: ${INVENTARIO_UPSTREAM_PORT}

      # Límites de recursos del proxy — evitan que el sidecar mismo se convierta en un cuello de botella.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 100
            max_pending_requests: 50
            max_requests: 100
            max_retries: 10

      # Outlier detection = implementación del patrón Circuit Breaker en Envoy.
      # Estados: CLOSED (normal) → OPEN (host eyectado) → HALF-OPEN (prueba automática).
      outlier_detection:
        # [5] consecutive_5xx = 3
        # Ante el fallo persistente (retraso de 5 s) todas las peticiones fallan, así que el circuito abre en
        # ~3 × 4.5s ≈ 13 s. Con 1 o 2 abriría por un error transitorio aislado (falsos positivos); con 5 o más
        # tardaría más en abrir y más peticiones lentas dañarían el p99 del ASR-1.
        consecutive_5xx: 3
        interval: 10s
        # [6] base_ejection_time = 30s
        # Es menor que RECOVERY_TIME_MS (600 s), como exige el lab. Envoy multiplica este tiempo por el número
        # de eyecciones (30 s, 60 s, 90 s…), así que durante los 10 min de fallo el circuito prueba HALF-OPEN
        # unas 6 veces y el intento cercano a los ~630 s detecta la recuperación antes de T0 + 12 min.
        # Un valor menor (10 s) reabriría ~11 veces, dejando pasar ráfagas de peticiones lentas a Inventario.
        base_ejection_time: 30s
        max_ejection_percent: 100
        enforcing_consecutive_5xx: 100
        enforcing_success_rate: 0
        split_external_local_origin_errors: false

admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 9901
